{
  "components": {
    "schemas": {
      "ApplicationRead": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "outcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Outcome"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when the application is closed."
          },
          "stage": {
            "$ref": "#/components/schemas/Stage",
            "description": "Current stage; for a closed application, the stage reached."
          }
        },
        "required": [
          "id",
          "stage",
          "outcome"
        ],
        "title": "ApplicationRead",
        "type": "object"
      },
      "FieldErrorRead": {
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldErrorRead",
        "type": "object"
      },
      "HealthRead": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthRead",
        "type": "object"
      },
      "Outcome": {
        "description": "How a closed application ended. A closed application keeps the stage it reached.",
        "enum": [
          "rejected",
          "ghosted",
          "withdrawn",
          "offer_declined"
        ],
        "title": "Outcome",
        "type": "string"
      },
      "ProblemRead": {
        "description": "Problem details returned by every error response.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "ProblemRead",
        "type": "object"
      },
      "Stage": {
        "description": "Funnel stages, in order. `discovered` arrives with phase 0 (out of the MVP).",
        "enum": [
          "evaluated",
          "applied",
          "screening",
          "interviewing",
          "offer",
          "accepted"
        ],
        "title": "Stage",
        "type": "string"
      },
      "TransitionCreate": {
        "description": "Move to a stage or close with an outcome: exactly one of `to_stage` and `outcome`.",
        "properties": {
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "occurred_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Defaults to today.",
            "title": "Occurred On"
          },
          "outcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Outcome"
              },
              {
                "type": "null"
              }
            ]
          },
          "to_stage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Stage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "TransitionCreate",
        "type": "object"
      },
      "TransitionRead": {
        "properties": {
          "from_stage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Stage"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null for the application's first stage."
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "occurred_on": {
            "format": "date",
            "title": "Occurred On",
            "type": "string"
          },
          "outcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Outcome"
              },
              {
                "type": "null"
              }
            ]
          },
          "to_stage": {
            "$ref": "#/components/schemas/Stage",
            "description": "Equals from_stage when the transition closes it."
          }
        },
        "required": [
          "from_stage",
          "to_stage",
          "outcome",
          "occurred_on",
          "note"
        ],
        "title": "TransitionRead",
        "type": "object"
      },
      "ValidationProblemRead": {
        "description": "Problem details for invalid requests, with one entry per invalid field.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldErrorRead"
            },
            "title": "Errors",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "errors"
        ],
        "title": "ValidationProblemRead",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Job Offer Funnel",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/applications/{application_id}": {
      "get": {
        "operationId": "read_application_api_v1_applications__application_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "application_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Application Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemRead"
                }
              }
            },
            "description": "Missing or invalid token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemRead"
                }
              }
            },
            "description": "Application does not exist"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemRead"
                }
              }
            },
            "description": "Invalid request (`validation-error`)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Application",
        "tags": [
          "applications"
        ]
      }
    },
    "/api/v1/applications/{application_id}/transitions": {
      "get": {
        "description": "Transition history, oldest first.",
        "operationId": "list_transitions_api_v1_applications__application_id__transitions_get",
        "parameters": [
          {
            "in": "path",
            "name": "application_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Application Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TransitionRead"
                  },
                  "title": "Response List Transitions Api V1 Applications  Application Id  Transitions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemRead"
                }
              }
            },
            "description": "Missing or invalid token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemRead"
                }
              }
            },
            "description": "Application does not exist"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemRead"
                }
              }
            },
            "description": "Invalid request (`validation-error`)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Transitions",
        "tags": [
          "applications"
        ]
      },
      "post": {
        "description": "Move the application to a later stage, or close it with an outcome.",
        "operationId": "create_transition_api_v1_applications__application_id__transitions_post",
        "parameters": [
          {
            "in": "path",
            "name": "application_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Application Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransitionCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransitionRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemRead"
                }
              }
            },
            "description": "Missing or invalid token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemRead"
                }
              }
            },
            "description": "Application does not exist"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemRead"
                }
              }
            },
            "description": "Transition not allowed from the current state (`invalid-transition`)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ValidationProblemRead"
                    },
                    {
                      "$ref": "#/components/schemas/ProblemRead"
                    }
                  ],
                  "title": "Response 422 Create Transition Api V1 Applications  Application Id  Transitions Post"
                }
              }
            },
            "description": "Invalid body (`validation-error`), or date in the future or before the previous transition (`invalid-transition-date`)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Transition",
        "tags": [
          "applications"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Public liveness check that also verifies the database connection.",
        "operationId": "read_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthRead"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Health",
        "tags": [
          "health"
        ]
      }
    }
  }
}
