# Copy to .env (not versioned). `just` loads it automatically.
POSTGRES_USER=funnel
POSTGRES_PASSWORD=funnel
POSTGRES_DB=funnel
POSTGRES_PORT=5434

DATABASE_URL=postgresql+asyncpg://funnel:funnel@localhost:5434/funnel
AUTH_TOKEN=change-me
LOG_LEVEL=INFO

# Optional: `just import-offers` reads LinkedIn job alerts by IMAP from the Gmail account
# dedicated to them, with an app password (myaccount.google.com/apppasswords).
# Without them alerts are skipped.
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=

# Optional: key of the offer reader and the offer triager (console.groq.com/keys). The
# reader reads what each offer says about remote work, where it can be done and whether it
# is a stable job; the triager suggests discarding the pending offers like the ones you
# discard. Without it nothing is read or triaged and the rest works the same.
# GROQ_API_KEY=

# Optional: triage with Claude Code on your Claude subscription instead of Groq
# (`claude` installed and signed in), 20 offers at a time; CLAUDE_CODE_MODEL defaults to
# sonnet. `just dev-prod` sets it and points the API at PROD_DATABASE_URL (Neon's URL as
# in Render: direct endpoint, postgresql+asyncpg://...?ssl=require): what it triages is
# seen in the deployed app.
# OFFER_TRIAGER=claude-code
# CLAUDE_CODE_MODEL=sonnet
# PROD_DATABASE_URL=

# Port of the API run by `just up` (`just dev` uses 8000)
API_PORT=8080

# Port of the web app run by `just up` (`just frontend-dev` uses 5173)
WEB_PORT=8081
