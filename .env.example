# Copy to .env (not versioned). `just` loads it automatically.
POSTGRES_USER=funnel
POSTGRES_PASSWORD=funnel
POSTGRES_DB=funnel
POSTGRES_PORT=5434

DATABASE_URL=postgresql+asyncpg://funnel:funnel@localhost:5434/funnel
AUTH_TOKEN=change-me
LOG_LEVEL=INFO

# Optional: `just import-offers` reads LinkedIn job alerts by IMAP from the Gmail account
# dedicated to them, with an app password (myaccount.google.com/apppasswords).
# Without them alerts are skipped.
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=

# Optional: key of the offer reader (console.groq.com/keys), which reads what each offer
# says about remote work, where it can be done and whether it is a stable job.
# Without it no offer is read and the rest works the same.
# GROQ_API_KEY=

# Port of the API run by `just up` (`just dev` uses 8000)
API_PORT=8080

# Port of the web app run by `just up` (`just frontend-dev` uses 5173)
WEB_PORT=8081
